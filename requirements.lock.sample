#
#   mcp>=1.0.0,<2.0.0
#   pydantic>=2.0,<3.0
#   pydantic-settings>=2.0,<3.0
#   chromadb>=0.5,<0.6
#   trafilatura>=1.0,<2.0
#   httpx>=0.27,<0.28
#   tiktoken>=0.7,<0.8
#
# with all of these moved to extras (NOT in default install):
#
#   sentence-transformers   ->  extras['embed-local-st']      (+1.3GB)
#   qdrant-fastembed        ->  extras['embed-local-onnx']    (+150MB)
#   tree-sitter             ->  extras['ingest-codebase']
#   tree-sitter-languages   ->  extras['ingest-codebase']     (+100MB)
#   gitpython               ->  extras['ingest-codebase']
#   pdfplumber              ->  extras['ingest-file']
#   sqlalchemy              ->  extras['ingest-sql']
#   sqlparse                ->  extras['ingest-sql']
#
# Realistic install-size floor: ~700MB default (chromadb dominates).
